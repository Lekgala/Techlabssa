# API configuration. Copy to .env and replace every example value.
PORT=4000
# Exact public frontend URL. Secure account links in emails use this value.
APP_ORIGIN=http://localhost:3000
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Public contact details may be exposed through Vite variables.
VITE_WHATSAPP_NUMBER=+27000000000
# Optional dedicated WhatsApp number for enrolled student support.
VITE_STUDENT_SUPPORT_WHATSAPP_NUMBER=+27000000000
PUBLIC_STUDENT_SUPPORT_WHATSAPP_NUMBER=+27000000000

# Resend transactional email (server-side only).
RESEND_API_KEY=re_replace_with_your_api_key
# Optional: override only for isolated automated tests. Leave unset in production.
# RESEND_API_URL=http://127.0.0.1:4016/emails
RESEND_WEBHOOK_SECRET=whsec_replace_with_your_signing_secret
EMAIL_FROM="TechLabs Academy <admissions@techlabs.madilotane.co.za>"
EMAIL_REPLY_TO=admissions@madilotane.co.za
PAYMENT_PROOF_DIR=server/data/payment-proofs
